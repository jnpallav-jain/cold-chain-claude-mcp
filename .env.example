# Copy to .env and fill locally. No credentials are supplied.
# SDK migration settings (not consumed by the current baseline yet):
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Baseline settings used before Part 3:
Agent_llm=DEEPSEEK
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
Embeddings_model=LOCAL
Local_Embedding_Model=BAAI/bge-m3
PINECONE_API_KEY=
# Reserved for Part 2: baseline still hardcodes its Pinecone index names.
PINECONE_INDEX_NAME=cold-chain-claude-mcp-sop-local
# Separate database container should use host port 1434, not original port 1433.
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1434
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=
# Relative paths are resolved from the directory where the loader is run.
TELEMETRY_CSV_PATH=data/sample/synthetic_fleet.csv
