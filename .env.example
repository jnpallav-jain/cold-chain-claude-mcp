# Copy to .env; fill credentials locally. Never commit .env.
# Claude Agent SDK (API key stays server-side):
ANTHROPIC_API_KEY=
# SDK alias; set an explicit supported model ID for pinned deployments.
CLAUDE_MODEL=sonnet
CLAUDE_MAX_TURNS=8
CLAUDE_MAX_BUDGET_USD=0.5
CLAUDE_REQUEST_TIMEOUT=120
# Embeddings and project-only Pinecone resources:
EMBEDDING_MODE=LOCAL
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
PINECONE_INDEX_NAME=cold-chain-claude-mcp-sop-local
PINECONE_NAMESPACE=sop-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
RETRIEVAL_K=2
# Docker Compose exposes the isolated SQL instance on this loopback port:
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1434
SQL_DATABASE=cold_chain_claude_mcp
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=
SQL_AGENT_USER=USR_CC_CLAUDE_RO
SQL_AGENT_PASSWORD=
SQL_LOGIN_TIMEOUT=8
SQL_ROW_LIMIT=10
# Paths are relative to the project root, not the calling shell directory:
TELEMETRY_CSV_PATH=data/sample/synthetic_fleet.csv
POLICY_DIR=data/policy
WEATHER_TIMEOUT=6

# Part 4 deterministic execution limits:
SQL_QUERY_TIMEOUT=3
SQL_POOL_TIMEOUT=3
SQL_MAX_CHARS=8000
TOOL_TIMEOUT=45
TOOL_MAX_ATTEMPTS=1
TOOL_WORKER_LIMIT=2
TOOL_MAX_OUTPUT_BYTES=16384
CLAUDE_MAX_TOOL_CALLS=8
CLAUDE_MAX_PROMPT_CHARS=6000

# Local human approval (separate from SQL admin/API credentials). Blank hash disables proposals.
# Configure without printing the password: python -m scripts.configure_operator
APPROVAL_OPERATOR=dispatcher
APPROVAL_PASSWORD_HASH=
APPROVAL_DB_PATH=data/control/approvals.sqlite3
APPROVAL_TTL_SECONDS=900
